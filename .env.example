# ------------------------------------------------------------
# CraftAI backend - environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to GitHub (it is already in .gitignore).
# ------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (use * only for local testing)
CORS_ORIGINS=http://localhost:5173

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Model id. Change any time without touching code.
GEMINI_MODEL=gemini-4-hydrogen
# Max seconds to wait for Gemini before giving up
GEMINI_TIMEOUT_SECONDS=120

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only key. Keep it secret, never send it to the browser/app.
SUPABASE_SERVICE_ROLE_KEY=

# GitHub (fine-grained token with "Contents: Read and write" on your repos)
GITHUB_TOKEN=
# Optional defaults used when a request does not send owner/repo/branch
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=
GITHUB_DEFAULT_BRANCH=main

# Limits
MAX_FILES_PER_PROJECT=500
MAX_FILE_SIZE_KB=512
MAX_PROMPT_CHARS=20000
